	(text "ADC_V = VMID + (VIN - VMID) x R12 / (R10 + R11 + R12)\nVIN = ADC_V + (ADC_V - VMID) x 20.0; VMID is measured on ADC_VMID.\nVMID_EN high only while measuring: VMID = 1.56 V, range -31 to +32 V.\nOverload current is set by R10 + R11 (3 uA at 30 V) into the PA4 clamp."
		(exclude_from_sim no)
		(at 274.32 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "215cf5bc-4431-5a2f-ba67-e7f46f441b10")
	)
	(text "C6, C7 at VDD pins 1 and 17;\nC8, C9 at VDDA pin 5"
		(exclude_from_sim no)
		(at 175.26 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "282dc984-6a05-5cd9-9f02-c29293e22a03")
	)
	(text "J4 unpopulated: hold a header in it\nor solder one for an ST-Link.\n1 3V0 2 SWDIO 3 SWCLK 4 NRST 5 GND"
